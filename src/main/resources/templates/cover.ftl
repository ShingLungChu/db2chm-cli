<!DOCTYPE HTML>
<html lang="zh-CN">
<head>
    <meta charset="${charset!"UTF-8"}">
    <title>全量数据字典</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body style="margin:0; padding:0; height:100%; background:#122a52;">
<table class="cover-table" cellpadding="0" cellspacing="0" border="0">
    <tr>
        <td class="cover-td">

            <div class="cover-frame-top">
                <span class="cover-line1"></span>
                <span class="cover-line2"></span>
                <span class="cover-diamond"></span>
                <span class="cover-diamond cover-diamond-right"></span>
            </div>

            <div class="cover-inner">
                <div class="cover-eyebrow">GROUP&nbsp;TREASURY&nbsp;&middot;&nbsp;DATA&nbsp;DICTIONARY</div>
                <h1 class="cover-title">全量数据字典</h1>
                <div class="cover-divider">
                    <span class="cover-diamond"></span>
                    <span class="cover-diamond cover-diamond-right"></span>
                </div>

                <h2 class="cover-subtitle">
                    <span class="cover-sub-label">日期</span>
                    <span class="cover-sub-value">${generatedAt?html}</span>
                </h2>
                <h2 class="cover-subtitle">
                    <span class="cover-sub-label">数据库</span>
                    <span class="cover-sub-value">${dbType?html}</span>
                </h2>

                <div class="cover-foot">集团司库系统</div>
            </div>

            <div class="cover-frame-bottom">
                <span class="cover-line1"></span>
                <span class="cover-line2"></span>
                <span class="cover-diamond"></span>
                <span class="cover-diamond cover-diamond-right"></span>
            </div>

        </td>
    </tr>
</table>
</body>
</html>