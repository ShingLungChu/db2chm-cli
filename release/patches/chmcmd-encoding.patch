+procedure TIndexedWordList.EatProfileWords(Words: AnsiString; IsTitle: Boolean);
+var U: UnicodeString; i,j,k,base: Integer; B: UTF8String; S: string;
+    W: TIndexedWord;
+function Han(C: WideChar): Boolean;
+begin Result:=(Ord(C)>=$3400) and (Ord(C)<=$9FFF); end;
+function AsciiWord(C: WideChar): Boolean;
+begin Result:=(C>='a') and (C<='z') or (C>='A') and (C<='Z') or
+ (C>='0') and (C<='9') or (C='_'); end;
+procedure Add(const Text: UnicodeString; Position: Integer);
+begin
+ B:=UTF8Encode(Text);SetLength(S,Length(B));
+ if Length(B)>0 then Move(B[1],S[1],Length(B));
+ W:=AddGetWord(TargetBytes(S),IsTitle);
+ W.DocumentTopic[FTopicIndex].AddWordIndex(Position);
+end;
+begin
+ if IsTitle then FDocTitle:=Words;
+ U:=InputUnicode(Words);
+ for i:=1 to Length(U) do if (U[i]>='A') and (U[i]<='Z') then U[i]:=WideChar(Ord(U[i])+32);
+ i:=1;
+ while i<=Length(U) do begin
+  if Han(U[i]) then begin
+   j:=i;while (j<=Length(U)) and Han(U[j]) do Inc(j);
+   base:=FWordCount;
+   for k:=i to j-1 do begin
+    Add(Copy(U,k,1),base+k-i);
+   end;
+   Inc(FWordCount,j-i);i:=j;
+  end else if AsciiWord(U[i]) then begin
+   j:=i;while (j<=Length(U)) and AsciiWord(U[j]) do Inc(j);
+   Add(Copy(U,i,j-i),FWordCount);Inc(FWordCount);i:=j;
+  end else Inc(i);
+ end;
 end;
 
