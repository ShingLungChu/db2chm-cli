+++ b/packages/chm/src/chmencoding.pas
@@ -0,0 +1,79 @@
+{ db2chm UTF-8 input / Simplified Chinese CHM output profile.
+  Copyright 2026 db2chm contributors. LGPL-2.0-or-later, as the CHM utility. }
+unit chmencoding;
+{$mode objfpc}{$H+}
+interface
+uses {$ifdef MSWINDOWS}uuchar,{$endif} SysUtils, Classes;
+var Db2ChmEncoding: Boolean = False;
+function InputUnicode(const S: string): UnicodeString;
+function TargetBytes(const S: string): string;
+function HtmlInputText(const S: string): string;
+procedure EncodeNavigationStream(S: TStream);
+procedure EnableUtf8Paths;
+function ChmParamStr(I: Integer): string;
+implementation
+type TCP936String = type AnsiString(936);
+procedure EnableUtf8Paths;
+begin
+ {$ifdef MSWINDOWS}
+ // Process-local RTL settings; do not change Windows locale or console settings.
+ SetMultiByteConversionCodePage(CP_UTF8);
+ SetMultiByteFileSystemCodePage(CP_UTF8);
+ SetMultiByteRTLFileSystemCodePage(CP_UTF8);
+ {$endif}
+end;
+function ChmParamStr(I: Integer): string;
+{$ifdef MSWINDOWS}var U: UTF8String;{$endif}
+begin
+ {$ifdef MSWINDOWS}
+ U:=UTF8Encode(uuchar.ParamStr(I));
+ SetLength(Result,Length(U));
+ if Length(U)>0 then Move(U[1],Result[1],Length(U));
+ {$else}Result:=ParamStr(I);{$endif}
+end;
+function HtmlInputText(const S: string): string;
+begin
+ Result:=S;
+ if not Db2ChmEncoding then Exit;
+ Result:=StringReplace(Result,'&quot;','"',[rfReplaceAll]);
+ Result:=StringReplace(Result,'&apos;',#39,[rfReplaceAll]);
+ Result:=StringReplace(Result,'&lt;','<',[rfReplaceAll]);
+ Result:=StringReplace(Result,'&gt;','>',[rfReplaceAll]);
+ Result:=StringReplace(Result,'&amp;','&',[rfReplaceAll]);
+end;
+function InputUnicode(const S: string): UnicodeString;
+var U: UTF8String;
+begin
+ if not Db2ChmEncoding then Exit(UnicodeString(S));
+ SetLength(U,Length(S));
+ if Length(S)>0 then Move(S[1],U[1],Length(S));
+ Result:=UTF8Decode(U);
+ if UTF8Encode(Result)<>U then
+  raise Exception.Create('DB2CHM_ENCODING: invalid UTF-8 input');
+end;
+function TargetBytes(const S: string): string;
+var U: UnicodeString; B: TCP936String;
+begin
+ if not Db2ChmEncoding then Exit(S);
+ U:=InputUnicode(S);
+ B:=TCP936String(U);
+ if UnicodeString(B)<>U then
+  raise Exception.Create('DB2CHM_ENCODING: text cannot be represented in CP936');
+ // Copy bytes explicitly: assignment to a system-codepage string would recode
+ // the result on a UTF-8 host. Offsets and lengths must use these final bytes.
+ SetLength(Result,Length(B));
+ if Length(B)>0 then Move(B[1],Result[1],Length(B));
+end;
+procedure EncodeNavigationStream(S: TStream);
+var B: string;
+begin
+ if not Db2ChmEncoding then Exit;
+ S.Position:=0;SetLength(B,S.Size);
